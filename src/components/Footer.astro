---
import { site } from '../site.config';

const links = [
  { label: 'Full Story', href: '/story' },
  site.video && { label: 'Video', href: site.video },
  site.repo && { label: 'Code', href: site.repo },
  site.slides && { label: 'Slides', href: site.slides },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="border-t border-border">
  <div
    class="wrap flex flex-col items-center gap-4 py-8 text-center text-sm text-muted sm:flex-row sm:justify-between sm:gap-3 sm:text-left"
  >
    <p>
      <span class="inline-block">{site.name} ·</span>{' '}
      <span class="inline-block">{site.award}, <span translate="no">{site.event}</span></span>
    </p>
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="nav-link">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
