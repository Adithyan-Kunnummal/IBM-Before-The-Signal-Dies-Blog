---
import SignalMark from './SignalMark.astro';
import { nav, site } from '../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header class="site-header relative border-b border-border">
  <div class="wrap flex items-center justify-between gap-x-6 py-2">
    <a href="/" class="group -mx-1 inline-flex min-h-11 items-center gap-2 px-1 font-semibold tracking-tight">
      <SignalMark class="h-4 w-4 text-accent" />
      <span class="transition-colors group-hover:text-accent">{site.name}</span>
    </a>

    <!-- Tablet and desktop: inline links -->
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-x-7 text-[15px] whitespace-nowrap">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-link inline-flex min-h-11 items-center"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Phone: menu button + popover panel -->
    <button
      type="button"
      popovertarget="mobile-menu"
      class="menu-button -mr-2 grid h-11 w-11 place-items-center rounded-lg text-text md:hidden"
      aria-label="Menu"
    >
      <svg class="icon-open h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <svg class="icon-close h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav id="mobile-menu" popover aria-label="Main" class="mobile-menu md:hidden">
      <ul class="py-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="mobile-link flex min-h-12 items-center justify-between px-5 text-[17px]"
              >
                {item.label}
                <svg class="h-4 w-4 text-muted" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M6 3.5L10.5 8 6 12.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Close the phone menu after a link is tapped (in-page links don't reload the page).
  document.getElementById('mobile-menu')?.addEventListener('click', (e) => {
    if (e.target.closest('a')) e.currentTarget.hidePopover?.();
  });
</script>

<style>
  .menu-button {
    transition: background-color var(--m-out) var(--m-ease);
  }
  .menu-button:hover,
  .site-header:has(.mobile-menu:popover-open) .menu-button {
    background: var(--surface);
  }
  .icon-close {
    display: none;
  }
  .site-header:has(.mobile-menu:popover-open) .icon-open {
    display: none;
  }
  .site-header:has(.mobile-menu:popover-open) .icon-close {
    display: block;
  }

  /* The panel drops in just below the header, inset to the page gutters. */
  .mobile-menu {
    position: fixed;
    inset: 3.75rem 1rem auto 1rem;
    width: auto;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.25);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 200ms var(--m-ease),
      transform 200ms var(--m-ease),
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .mobile-menu::backdrop {
    background: rgb(0 0 0 / 0.15);
  }
  .mobile-link {
    color: var(--text);
  }
  .mobile-link:active {
    background: var(--bg);
  }
  .mobile-link[aria-current='page'] {
    color: var(--accent);
    font-weight: 550;
  }
  .mobile-menu li + li .mobile-link {
    border-top: 1px solid var(--border);
  }
</style>
